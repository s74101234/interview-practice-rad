# Copy this file to .env and fill in the values.
# Windows: copy .env.example .env
# macOS/Linux: cp .env.example .env

# Google Gemini API key — used for text generation and vector embeddings.
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Enable or disable the NotebookLM browser automation feature (Task 3).
# When enabled, the chat agent can automatically create a NotebookLM notebook
# from the uploaded PDF and return a shareable link.
# Requires a local Windows machine with Edge and a logged-in Google account.
NOTEBOOKLM_ENABLED=true

# Path to your Edge browser user data directory.
# Playwright reads this to reuse your existing Google login session for NotebookLM automation.
# Replace <username> with your actual Windows username.
EDGE_USER_DATA=C:\Users\<username>\AppData\Local\Microsoft\Edge\User Data

# Edge profile name. Only change this if you use multiple profiles.
EDGE_PROFILE=Default
